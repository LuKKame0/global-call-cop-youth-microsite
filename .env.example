# Neon Postgres connection string. Required for database features.
DATABASE_URL=

# Optional. If empty, Sheets delivery is skipped (submission still succeeds).
GOOGLE_SHEETS_WEBHOOK_URL=

# Keep Google Sheets sync active alongside Postgres (true/false).
SYNC_TO_SHEETS=true

# Auth.js secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Admin email + 6-digit access code login (comma-separated).
AUTH_ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Exactly 6 digits. Set in deployment env — never commit production values.
AUTH_ACCESS_TOKEN=

# Google OAuth (optional, for dashboard login).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Email delivery ─────────────────────────────────────────────────
# Option A — SMTP (no REST API). Example: Gmail, Outlook, Google Workspace.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465, false for 587/STARTTLS
SMTP_SECURE=false

# Option B — Mailgun HTTP API (https://github.com/mailgun/mailgun-js — used via native fetch)
MAILGUN_API_KEY=
# US (default) or EU
MAILGUN_REGION=US

# Option C — Resend API (used when SMTP and Mailgun are not configured)
EMAIL_API_KEY=

# Optional: redirect ALL outgoing mail to one inbox while DNS/domain is pending.
EMAIL_OVERRIDE_TO=

# Verified sender on your email provider domain.
# Example: noreply@yourdomain.org
SENDER_EMAIL=

# Comma- or semicolon-separated internal notification recipients.
INTERNAL_NOTIFY_EMAILS=ops@example.com

# Admin sign-in security alerts (one email per recipient — no shared To header).
# Defaults to enabled when email transport is configured.
SIGN_IN_ALERTS_ENABLED=true
# Optional override. If empty, falls back to INTERNAL_NOTIFY_EMAILS.
SIGN_IN_ALERT_RECIPIENTS=

# Public base URL (canonical domain for all surfaces).
NEXT_PUBLIC_APP_URL=https://theglobalcall.org

# Legacy — no longer required (framework lives at /insights on the same domain).
# NEXT_PUBLIC_FRAMEWORK_URL=

# ─── AI / Inference (Phase 2) ───────────────────────────────────────
# NVIDIA NIM API key and endpoint.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct

# AI provider selector (default: nvidia-nim).
AI_PROVIDER=nvidia-nim
